generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// ── 사용자
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String?
  image         String?
  phone         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())

  accounts          Account[]
  sessions          Session[]
  members           WorkspaceMember[]
  assignedTasks     Task[]            @relation("AssignedTo")
  createdTasks      Task[]            @relation("CreatedBy")
  comments          Comment[]
  mentions          Mention[]
  events            Event[]
  calendarGroups              CalendarGroup[]          @relation("CalendarGroupOwner")
  pages             Page[]
  attendances       Attendance[]
  approvals         Approval[]        @relation("RequestedBy")
  approvalDecisions Approval[]        @relation("DecidedBy")
  notifications     Notification[]
  notices           Notice[]
  noticeReads       NoticeRead[]
  taskAttachments   TaskAttachment[]  @relation("TaskAttachmentUploader")
  boardPosts        BoardPost[]
  boardLikes        BoardLike[]
  boardReads        BoardRead[]
  detailComments    DetailComment[]
  errorReports                ErrorReport[]
  managedSubscriptionServices SubscriptionService[]    @relation("SubscriptionManager")
  createdSubscriptionServices SubscriptionService[]    @relation("SubscriptionCreatedBy")
  updatedSubscriptionServices SubscriptionService[]    @relation("SubscriptionUpdatedBy")
  subscriptionServiceLogs     SubscriptionServiceLog[] @relation("SubscriptionLogActor")
  pushSubscriptions PushSubscription[]
}

// ── 워크스페이스
model Workspace {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  inviteCode String   @unique @default(cuid())
  logoUrl    String?
  description String?
  industry    String?
  teamSize    String?
  themeColor  String?
  createdAt  DateTime @default(now())

  workStartTime   String @default("09:00")
  workEndTime     String @default("18:00")
  workHoursPerDay Float  @default(8.0)
  lateGraceMinutes       Int     @default(10)
  checkoutConfirmPopup   Boolean @default(true)
  showAttendanceMemo     Boolean @default(false)
  excludeOwnerAttendance Boolean @default(true)
  notifyCheckoutMissed   Boolean @default(true)
  notifyNextDayMissing   Boolean @default(true)
  checkoutAlertTime      String  @default("18:10")
  missingAlertTime       String  @default("09:00")
  weekdayCheckIn_0       String?
  weekdayCheckOut_0      String?
  weekdayOff_0           Boolean @default(false)
  weekdayCheckIn_1       String?
  weekdayCheckOut_1      String?
  weekdayOff_1           Boolean @default(false)
  weekdayCheckIn_2       String?
  weekdayCheckOut_2      String?
  weekdayOff_2           Boolean @default(false)
  weekdayCheckIn_3       String?
  weekdayCheckOut_3      String?
  weekdayOff_3           Boolean @default(false)
  weekdayCheckIn_4       String?
  weekdayCheckOut_4      String?
  weekdayOff_4           Boolean @default(false)
  weekdayCheckIn_5       String?
  weekdayCheckOut_5      String?
  weekdayOff_5           Boolean @default(true)
  weekdayCheckIn_6       String?
  weekdayCheckOut_6      String?
  weekdayOff_6           Boolean @default(true)
  notif_confirm_request  String  @default("push")
  notif_deadline_d1      String  @default("push")
  notif_budget_over      String  @default("push")
  notif_confirm_result   String  @default("badge")
  notif_mention          String  @default("badge")
  notif_notice_new       String  @default("badge")
  notif_idea_like        String  @default("off")
  notif_notice_read      String  @default("off")

  members     WorkspaceMember[]
  inviteTokens InviteToken[]
  projects    Project[]
  events      Event[]
  calendarGroups          CalendarGroup[]
  pages       Page[]
  notices     Notice[]
  boardPosts  BoardPost[]
  subscriptionServices    SubscriptionService[]
  subscriptionServiceLogs SubscriptionServiceLog[]
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  role        Role     @default(MEMBER)
  annualLeave Int      @default(12)
  personalColor String?
  joinedAt    DateTime @default(now())
  userId      String
  workspaceId String

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@unique([workspaceId, personalColor])
}

model InviteToken {
  id          String    @id @default(cuid())
  token       String    @unique
  role        Role
  expiresAt   DateTime?
  usedCount   Int       @default(0)
  memo        String?
  createdAt   DateTime  @default(now())
  workspaceId String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

// ── 프로젝트
model Project {
  id          String        @id @default(cuid())
  name        String
  subtitle    String?
  description String?
  color       String        @default("#F56B23")
  status      ProjectStatus @default(ACTIVE)
  budget      Float?
  progress    Int?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime      @default(now())
  workspaceId String

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  tasks     Task[]
  events    Event[]
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

// ── 태스크
model Task {
  id               String     @id @default(cuid())
  title            String
  description      String?
  status           TaskStatus @default(TODO)
  priority         Priority   @default(MEDIUM)
  requiresApproval Boolean    @default(false)
  budget           Float?
  startDate           DateTime?
  dueDate          DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  projectId        String
  assigneeId       String?
  creatorId        String
  progress         Int?       @default(0)
  isApprovalRequested Boolean    @default(false)
  approvedBy          String?
  approvedAt          DateTime?
  rejectedReason      String?

  project   Project   @relation(fields: [projectId], references: [id])
  assignee  User?     @relation("AssignedTo", fields: [assigneeId], references: [id])
  creator   User      @relation("CreatedBy", fields: [creatorId], references: [id])
  comments  Comment[]
  tags      Tag[]
  approvals Approval[]
  attachments TaskAttachment[]
}

model TaskAttachment {
  id          String   @id @default(cuid())
  taskId      String
  name        String
  size        Int      @default(0)
  mimeType    String?
  storagePath String?
  url         String?
  createdAt   DateTime @default(now())
  uploaderId  String

  task     Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader User @relation("TaskAttachmentUploader", fields: [uploaderId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@index([uploaderId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ── 일정
enum CalendarEventGroupKind {
  PERSONAL
  COMPANY_ALL
  TEAM_SHARED
  PROJECT
  CUSTOM
}

model Event {
  id               String                 @id @default(cuid())
  title            String
  description      String?
  startAt          DateTime
  endAt            DateTime
  allDay           Boolean                @default(false)
  color            String                 @default("#F56B23")
  textColor        String                 @default("#3158C6")
  isImportant      Boolean                @default(false)
  requiresApproval Boolean                @default(false)
  groupKind        CalendarEventGroupKind @default(PERSONAL)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  workspaceId      String
  creatorId        String
  customGroupId    String?
  projectId        String?

  workspace   Workspace      @relation(fields: [workspaceId], references: [id])
  creator     User           @relation(fields: [creatorId], references: [id])
  customGroup CalendarGroup? @relation(fields: [customGroupId], references: [id], onDelete: SetNull)
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  approvals   Approval[]

  @@index([workspaceId, startAt], map: "Event_calendar_workspaceId_startAt_idx")
  @@index([workspaceId, endAt], map: "Event_calendar_workspaceId_endAt_idx")
  @@index([workspaceId, groupKind], map: "Event_calendar_workspaceId_groupKind_idx")
  @@index([customGroupId], map: "Event_calendar_customGroupId_idx")
  @@index([projectId], map: "Event_calendar_projectId_idx")
}

model CalendarGroup {
  id          String   @id @default(cuid())
  name        String
  color       String
  ownerId     String
  workspaceId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner     User      @relation("CalendarGroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  events    Event[]

  @@index([workspaceId, ownerId], map: "CalendarGroup_calendar_workspaceId_ownerId_idx")
  @@index([ownerId, createdAt], map: "CalendarGroup_calendar_ownerId_createdAt_idx")
}

// ── 문서
model Page {
  id          String   @id @default(cuid())
  title       String   @default("제목 없음")
  content     Json?
  emoji       String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  parentId    String?
  workspaceId String
  authorId    String

  parent    Page?     @relation("PageTree", fields: [parentId], references: [id])
  children  Page[]    @relation("PageTree")
  workspace Workspace @relation(fields: [workspaceId], references: [id])
  author    User      @relation(fields: [authorId], references: [id])
  comments  Comment[]
}

// ── 댓글 + 멘션
model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  authorId  String
  taskId    String?
  pageId    String?

  author   User      @relation(fields: [authorId], references: [id])
  task     Task?     @relation(fields: [taskId], references: [id])
  page     Page?     @relation(fields: [pageId], references: [id])
  mentions Mention[]
}

enum CommentTargetType {
  document
  project
  idea
  notice
  delivery
}

model DetailComment {
  id         String            @id @default(cuid())
  targetType CommentTargetType
  targetId   String
  content    String
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  authorId   String

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId, createdAt])
  @@index([authorId])
}

model ErrorReport {
  id          String   @id @default(cuid())
  message     String
  currentPath String?
  createdAt   DateTime @default(now())
  userId      String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum SubscriptionBillingCycle {
  MONTHLY
  YEARLY
  QUARTERLY
  HALF_YEARLY
  ONE_TIME
}

enum SubscriptionServiceStatus {
  REVIEW
  ACTIVE
  CANCEL_SCHEDULED
  ENDED
}

enum SubscriptionServiceLogAction {
  CREATED
  UPDATED
  STATUS_CHANGED
  ENDED
  DELETED
}

model SubscriptionService {
  id                    String                    @id @default(cuid())
  serviceName           String
  websiteUrl            String?
  category              String?
  planName              String?
  billingAmount         Float
  currency              String
  billingCycle          SubscriptionBillingCycle
  firstPaidAt           DateTime?
  nextBillingAt         DateTime
  monthlyCostNormalized Float
  annualCostNormalized  Float
  managerUserId         String?
  teamName              String?
  purpose               String?
  status                SubscriptionServiceStatus
  cancellationMethod    String?
  memo                  String?
  endedAt               DateTime?
  deletedAt             DateTime?
  workspaceId           String
  createdById           String
  updatedById           String
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  workspace   Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  managerUser User?                    @relation("SubscriptionManager", fields: [managerUserId], references: [id])
  createdBy   User                     @relation("SubscriptionCreatedBy", fields: [createdById], references: [id])
  updatedBy   User                     @relation("SubscriptionUpdatedBy", fields: [updatedById], references: [id])
  logs        SubscriptionServiceLog[]

  @@index([workspaceId, deletedAt])
  @@index([workspaceId, status])
  @@index([managerUserId])
}

model SubscriptionServiceLog {
  id            String                       @id @default(cuid())
  serviceId     String
  workspaceId   String
  actorId       String
  actionType    SubscriptionServiceLogAction
  changedFields Json?
  createdAt     DateTime                     @default(now())

  service   SubscriptionService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User                @relation("SubscriptionLogActor", fields: [actorId], references: [id])

  @@index([serviceId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([actorId])
}

model Mention {
  id        String   @id @default(cuid())
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String
  commentId String

  user    User    @relation(fields: [userId], references: [id])
  comment Comment @relation(fields: [commentId], references: [id])
}

// ── 출퇴근
model Attendance {
  id          String           @id @default(cuid())
  date        DateTime
  checkIn     DateTime?
  checkOut    DateTime?
  workMinutes Int?
  status      AttendanceStatus @default(NORMAL)
  memo        String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  userId      String
  workspaceId String

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

enum AttendanceStatus {
  NORMAL
  LATE
  EARLY_LEAVE
  OVERTIME
  ABSENT
  HOLIDAY
}

// ── 대표 컨펌
model Approval {
  id           String         @id @default(cuid())
  type         ApprovalType
  title        String
  description  String?
  status       ApprovalStatus @default(PENDING)
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime       @default(now())

  requesterId String
  deciderId   String?
  taskId      String?
  eventId     String?
  leaveType   LeaveType?
  leaveStart  DateTime?
  leaveEnd    DateTime?

  requester User   @relation("RequestedBy", fields: [requesterId], references: [id])
  decider   User?  @relation("DecidedBy", fields: [deciderId], references: [id])
  task      Task?  @relation(fields: [taskId], references: [id])
  event     Event? @relation(fields: [eventId], references: [id])
}

enum ApprovalType {
  LEAVE_REQUEST
  IMPORTANT_EVENT
  DEADLINE_CHANGE
  BUDGET_TASK
  PROJECT_REVIEW
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveType {
  FULL_DAY
  HALF_AM
  HALF_PM
}

model Notice {
  id                 String      @id @default(cuid())
  title              String
  content            String
  badge              NoticeBadge
  category           String      @default("怨듭?")
  priority           String      @default("?쇰컲")
  target             String[]    @default([])
  requireReadConfirm Boolean     @default(false)
  startDate          DateTime
  endDate            DateTime
  createdAt          DateTime    @default(now())
  authorId           String
  workspaceId        String

  author    User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  reads     NoticeRead[]

  @@index([workspaceId, createdAt])
  @@index([workspaceId, endDate])
}

model NoticeRead {
  id       String   @id @default(cuid())
  readAt   DateTime @default(now())
  userId   String
  noticeId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@unique([noticeId, userId])
  @@index([noticeId, readAt])
}


enum NoticeBadge {
  SCHEDULE
  FACILITY
  NOTICE
  WORK
  OTHER
}

// ── 알림
model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
  userId    String

  user User @relation(fields: [userId], references: [id])
}

enum NotificationType {
  MENTION
  TASK_DUE
  TASK_APPROVAL_REQUEST
  APPROVAL_REQUEST
  APPROVAL_RESULT
  ATTENDANCE_REMINDER
  OVERTIME_ALERT
  NOTICE_POSTED
}

// NextAuth 필수
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Tag {
  id    String @id @default(cuid())
  name  String
  color String @default("#F56B23")
  tasks Task[]
}

// ── 팀 보드
model BoardPost {
  id          String           @id @default(cuid())
  type        BoardPostType
  title       String?
  content     String
  tags        String[]
  status      BoardPostStatus?
  visibility  BoardPostVisibility @default(SHARED)
  workspaceId String
  authorId    String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  author    User        @relation(fields: [authorId], references: [id])
  workspace Workspace   @relation(fields: [workspaceId], references: [id])
  likes     BoardLike[]
  reads     BoardRead[]
}

model BoardLike {
  id        String    @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime  @default(now())

  post BoardPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model BoardRead {
  id        String    @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime  @default(now())

  post BoardPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

enum BoardPostType {
  NOTICE
  IDEA
  CEO_MESSAGE
}

enum BoardPostStatus {
  REVIEW
  ADOPTED
  HOLD
}

enum BoardPostVisibility {
  SHARED
  PRIVATE
}

// ── 푸시 구독
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  auth      String
  p256dh    String
  createdAt DateTime @default(now())
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
